# Copy to .env and fill in once you have accounts. Everything below is
# optional at boot — the app runs fine with none of it set; checkout shows
# a "launching soon" state and analytics stay fully inert until configured.

# --- Database (required) ---
# Supabase Postgres pooled connection string (Supavisor, transaction mode,
# port 6543 — best for serverless/Vercel). Get it from the Supabase
# dashboard: Project Settings > Database > Connection string > URI
# ("Transaction pooler" tab). Looks like:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Transactional email (server-side only) ---
# API key from Resend > API Keys. Add this variable to BOTH Preview and
# Production in Vercel so Find My Event can be tested before launch.
RESEND_API_KEY=re_...
# Must use a domain or subdomain that shows Verified in Resend. Posy refuses to
# send customer mail through onboarding@resend.dev because that address can only
# deliver test messages to the Resend account owner's own email.
RESEND_FROM_EMAIL=Posy <hello@updates.posyplans.com>
# Replies should reach the public Posy support inbox even when a sending
# subdomain is used for SPF/DKIM reputation isolation.
RESEND_REPLY_TO_EMAIL=hello@posyplans.com

# --- Stripe (server-side only, never exposed to the browser) ---
# Test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Price ids for the Posy Plus product (Dashboard > Product catalog).
# Create one Product with two recurring Prices: $99/year and $11.99/month.
STRIPE_PRICE_ID_ANNUAL=price_...
STRIPE_PRICE_ID_MONTHLY=price_...
# Spark one-time unlock: a single Product with a one-time $9.99 Price. Grants
# one event its full AI-drafted plan (see server/routes.ts checkout section).
STRIPE_PRICE_ID_SPARK=price_...
# Only needed once the webhook endpoint (https://posyplans.com/api/stripe/webhook)
# is registered against Dashboard > Developers > Webhooks. Until then,
# /api/checkout/confirm activates entitlements without it.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cloudflare Web Analytics (client-side, must be prefixed VITE_) ---
# Site token from the Cloudflare dashboard: Analytics & Logs > Web Analytics >
# Add site (posyplans.com) > copy the token out of the generated snippet's
# data-cf-beacon attribute. Gated behind the cookie-consent "Analytics"
# toggle (see client/src/lib/analytics.ts and CookieConsentBanner.tsx).
VITE_CF_ANALYTICS_TOKEN=your-cf-beacon-token

# --- Google Analytics 4 (client-side, must be prefixed VITE_) ---
# GA4 Measurement ID from Google Analytics: Admin > Data Streams > (web
# stream) > "Measurement ID" (looks like G-XXXXXXXXXX). Loaded behind the
# cookie-consent "Analytics" toggle alongside Cloudflare, and used for the
# purchase conversion event (see client/src/lib/analytics.ts).
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Meta Pixel + Conversions API ---
# Pixel ID from Meta Events Manager (Data Sources > your pixel > Settings).
# Client-exposed (prefixed VITE_), loaded behind the cookie-consent
# "Marketing" toggle. Fires the browser-side Purchase event.
VITE_META_PIXEL_ID=1234567890
# Same pixel id for the server-side Conversions API. Optional — defaults to
# the VITE_META_PIXEL_ID value baked in server/metaCapi.ts if unset. Set it
# only if you need to override.
META_PIXEL_ID=1234567890
# Conversions API access token (SERVER-ONLY — never prefix with VITE_, never
# expose to the browser). Generate in Events Manager > your pixel > Settings >
# Conversions API > "Generate access token". Until this is set, server-side
# CAPI Purchase events are silently skipped.
META_CAPI_ACCESS_TOKEN=EAAxxxx...
